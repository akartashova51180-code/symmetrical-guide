# Copy to .env on the server. Keep .env out of Git and restrict its permissions (chmod 600).
DATA_ROOT=/srv/anastasia-brain/data
# Generate a long hex password with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Create the bot with BotFather. Never put the real token in Git, email, or this chat.
TELEGRAM_BOT_TOKEN=
# Your private numeric Telegram user ID; the bot ignores all other users.
TELEGRAM_ALLOWED_USER_IDS=
# Usually the same numeric ID as TELEGRAM_ALLOWED_USER_IDS; private chat only.
TELEGRAM_NOTIFY_CHAT_ID=
