# Copy to .env on the server; .env is ignored by Git. Never send this file in chat.
DATA_ROOT=/srv/anastasia-brain/data

# Supabase Dashboard -> Project -> Connect -> choose a PostgreSQL connection URI.
# Use sslmode=require. If the VPS has no IPv6 connectivity, prefer the Supavisor
# Session pooler URI. URL-encode reserved characters in the database password.
CORPORATE_BRAIN_DATABASE_URL=

# Optional Telegram delivery secrets; keep them only in the server's private .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_NOTIFY_CHAT_ID=
